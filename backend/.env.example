# Copy this file to .env and fill your real keys.
# Example (PowerShell): Copy-Item .env.example .env

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional
USE_LANGCHAIN=false
ALLOW_DEV_AUTH_BYPASS=true
DEV_AUTH_USERNAME=admin

# ── Deploy (homologação / produção) ───────────────────────────────────────────
# Local: deixe SQLALCHEMY_DATABASE_URI comentado para usar o SQLite padrão.
# Supabase: use a URL do Session pooler (porta 5432). Senhas com caracteres
# especiais precisam estar codificadas (ex.: @ vira %40).
# SQLALCHEMY_DATABASE_URI=postgresql://postgres.<ref>:<senha>@<host>.pooler.supabase.com:5432/postgres

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Em homologação/produção: ALLOW_DEV_AUTH_BYPASS=false

# Origens extras liberadas no CORS (localhost já é liberado), separadas por vírgula.
# CORS_ORIGINS=https://meuapp.vercel.app
# CORS_ORIGIN_REGEX=https://meuapp-.*\.vercel\.app
