# Copie para .env (Copy-Item .env.example .env) e preencha.

# URL da API do backend (termina em /api). Em produção/homologação, use a do serviço publicado.
VITE_API_URL=http://localhost:8000/api

# Login com Supabase Auth. Project URL e anon key ficam em Project Settings → API
# (a anon key é pública por desenho). Deixe vazio para rodar localmente sem login.
# O backend precisa ter SUPABASE_URL do MESMO projeto.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
